{
  "description": "research plugin hooks — auto-reingest entries on Write/Edit, rebuild indexes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${CLAUDE_PLUGIN_ROOT:-$CLAUDE_PROJECT_DIR}\"; hook=\"$root/hooks/post-write-reingest.sh\"; if [ -x \"$hook\" ]; then \"$hook\"; else printf '{}'; fi",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
