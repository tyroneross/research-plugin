{
  "description": "research plugin hooks — auto-reingest entries on Write/Edit, rebuild indexes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${RESEARCH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-$CLAUDE_PROJECT_DIR}}}\"; if [ -n \"$root\" ] && [ -x \"$root/hooks/post-write-reingest.sh\" ]; then \"$root/hooks/post-write-reingest.sh\"; else printf '{}'; fi",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
